      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einem Arbeitsfoto deinen aktuellen Standort hinzu, wenn du Standort-Stempel aktivierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your current location to a work photo when you enable location stamps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu ubicación actual a una foto de trabajo cuando activas la ubicación en el sello."
