    "NSCameraUsageDescription" : {
      "comment" : "Privacy purpose string",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiere deine Arbeit, um Fotos zu Projekten und Fotoberichten hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take photos of your work to add to projects and photo reports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz fotos de tu trabajo para añadirlas a proyectos e informes fotográficos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographiez votre travail pour l’ajouter à vos projets et rapports photo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимайте свою работу, чтобы добавлять фото в проекты и фотоотчёты."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy purpose string",
