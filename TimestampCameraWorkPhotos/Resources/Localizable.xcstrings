    "subscription.detail.billingRetry" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple konnte die Zahlungsmethode nicht belasten. Pro ist pausiert, bis die Zahlung klappt; deine Daten bleiben verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple couldn't charge the payment method. Pro is paused until billing succeeds; your data stays available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple no pudo cobrar con el método de pago. Pro queda en pausa hasta que se cobre; tus datos siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n’a pas pu débiter le moyen de paiement. Pro est suspendu jusqu’au paiement ; vos données restent accessibles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple не смог списать оплату. Pro приостановлен до успешной оплаты; данные остаются доступны."
          }
        }
      }
    },
