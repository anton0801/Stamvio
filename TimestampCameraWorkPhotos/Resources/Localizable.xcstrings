    "backup.reinstallWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten liegen nur auf diesem iPhone. Wenn du die App löschst, können lokale Daten verloren gehen – erstelle vorher eine Sicherung in „Dateien“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data is stored only on this iPhone. If you delete the app, local data may be lost — create a backup in Files beforehand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se guardan solo en este iPhone. Si eliminas la app, los datos locales pueden perderse: crea antes una copia en Archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données sont stockées uniquement sur cet iPhone. Si vous supprimez l’app, les données locales peuvent être perdues : créez d’abord une sauvegarde dans Fichiers."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные хранятся только на этом iPhone. При удалении приложения локальные данные могут быть потеряны — заранее сохраните копию в «Файлы»."
          }
        }
      }
    },
