    "stamp.default.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standardstempel gilt für neue Fotos. Vorhandene Fotos behalten ihren Stempel, bis du ihn in einem Projekt auf ausgewählte Fotos anwendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The default stamp is used for new photos. Existing photos keep their own stamp unless you apply it to selected photos in a project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sello por defecto se usa para las fotos nuevas. Las fotos existentes conservan su propio sello salvo que lo apliques a las seleccionadas en un proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tampon par défaut s’applique aux nouvelles photos. Les photos existantes gardent leur tampon, sauf si vous l’appliquez aux photos sélectionnées d’un projet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Штамп по умолчанию используется для новых фото. Уже сделанные фото сохраняют свой штамп, пока вы не примените его к выбранным в проекте."
          }
        }
      }
    },
