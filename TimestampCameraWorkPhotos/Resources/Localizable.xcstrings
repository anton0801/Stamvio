            "value" : "Bildtexte werden so exportiert, wie sie geschrieben sind – enthält einer eine Adresse, bearbeite ihn selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captions are exported as written — if a caption contains an address, edit it yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pies de foto se exportan tal cual: si contienen una dirección, edítalos tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
