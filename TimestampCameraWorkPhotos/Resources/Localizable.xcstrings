    "backup.create.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt eine ZIP-Datei mit Originalfotos, Projektdaten, Bildtexten, Paaren, Marken-Vorlagen und gespeicherten PDFs. Du wählst den Speicherort in „Dateien“. Immer kostenlos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a ZIP file with your original photos, project details, captions, pairs, brand presets and saved PDFs. You choose where to save it in Files. Free, always."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un archivo ZIP con tus fotos originales, datos de proyectos, pies de foto, pares, plantillas de marca y PDF guardados. Tú eliges dónde guardarlo en Archivos. Gratis, siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un fichier ZIP avec vos photos originales, les données des projets, les légendes, les paires, les modèles de marque et les PDF enregistrés. Vous choisissez l’emplacement dans Fichiers. Toujours gratuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаёт ZIP-файл с оригиналами фото, данными проектов, подписями, парами, фирменными пресетами и сохранёнными PDF. Место сохранения в «Файлах» выбираете вы. Всегда бесплатно."
          }
        }
      }
    },
