    "location.toggle.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig aus. Wenn aktiv, fragt die App nur bei Nutzung nach Zugriff und misst nur bei geöffneter Kamera. Ausschalten blockiert nie Fotos, Importe oder Berichte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. When on, the app asks for access only while in use and measures only while the camera is open. Turning it off never blocks photos, imports or reports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivada por defecto. Al activarla, la app pide acceso solo mientras se usa y mide solo con la cámara abierta. Desactivarla nunca bloquea fotos, importaciones ni informes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivée par défaut. Une fois activée, l’app demande l’accès uniquement pendant l’utilisation et ne mesure que lorsque l’appareil photo est ouvert. La désactiver ne bloque jamais les photos, imports ou rapports."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию выключено. При включении приложение просит доступ только при использовании и определяет место только при открытой камере. Выключение никогда не блокирует съёмку, импорт и отчёты."
          }
        }
      }
    },
