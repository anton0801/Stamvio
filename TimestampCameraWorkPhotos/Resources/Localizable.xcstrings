        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans position : le GPS est retiré des métadonnées et l’adresse et les coordonnées ne figurent pas sur le tampon. L’original privé dans l’app n’est pas modifié."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без местоположения: GPS удаляется из метаданных файла, адрес и координаты не попадают в штамп. Приватный оригинал в приложении не меняется."
          }
        }
