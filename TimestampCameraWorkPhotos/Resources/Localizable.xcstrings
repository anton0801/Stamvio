    "privacy.deleteAll.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Projekte, Fotos, Berichte, Vorlagen, den Adress-Cache und die Diagnose von diesem iPhone. Bereits in „Dateien“ oder „Fotos“ gesicherte Kopien bleiben. Dein Abo wird nicht gekündigt – verwalte es bei Apple. Der Verbrauch des kostenlosen Plans (genutzte Fotos und Projekte) bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes projects, photos, reports, presets, the address cache and diagnostics from this iPhone. Copies already saved in Files or Photos stay. Your subscription is not cancelled — manage it with Apple. The Free plan usage (photos and projects used) is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de este iPhone proyectos, fotos, informes, plantillas, la caché de direcciones y el diagnóstico. Las copias ya guardadas en Archivos o Fotos se mantienen. Tu suscripción no se cancela: gestiónala con Apple. Se conserva el uso del plan gratuito (fotos y proyectos usados)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime de cet iPhone les projets, photos, rapports, modèles, le cache d’adresses et les diagnostics. Les copies déjà enregistrées dans Fichiers ou Photos restent. Votre abonnement n’est pas résilié : gérez-le avec Apple. Le décompte de l’offre gratuite (photos et projets utilisés) est conservé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет с iPhone проекты, фото, отчёты, пресеты, кэш адресов и диагностику. Копии, уже сохранённые в «Файлах» или «Фото», останутся. Подписка не отменяется — управляйте ей через Apple. Учёт бесплатного лимита (использованные фото и проекты) сохраняется."
          }
        }
      }
    },
    "privacy.deleteAll.step1.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Projekte, Fotos und Berichte in dieser App werden gelöscht. Erstelle am besten vorher eine Sicherung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All projects, photos and reports in this app will be deleted. Consider creating a backup first."
