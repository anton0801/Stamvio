      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält nur App-Version, iOS-Version, Gerätemodell, Sprache, Thema, technische Fehlercodes und einen groben Bereich des freien Speichers. Keine Fotos, Adressen, GPS-Daten, Projektnamen oder dein Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contains only app version, iOS version, device model, language, topic, technical error codes and a rough free-space range. No photos, addresses, GPS, project names or your text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene solo la versión de la app, la versión de iOS, el modelo del dispositivo, el idioma, el tema, códigos técnicos de error y un rango aproximado de espacio libre. Sin fotos, direcciones, GPS, nombres de proyectos ni tu texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contient uniquement la version de l’app, la version d’iOS, le modèle d’appareil, la langue, le sujet, des codes d’erreur techniques et une plage approximative d’espace libre. Aucune photo, adresse, donnée GPS, nom de projet ni votre texte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только версия приложения и iOS, модель устройства, язык, тема, технические коды ошибок и грубый диапазон свободного места. Без фото, адресов, GPS, названий проектов и вашего текста."
          }
        }
      }
    },
