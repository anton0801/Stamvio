    "paywall.finePrint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro %@. Das Abo verlängert sich automatisch, bis du es kündigst. Kündige spätestens 24 Stunden vor Ende des Zeitraums unter Einstellungen → Apple Account → Abonnements."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per %@. The subscription renews automatically until you cancel it. Cancel at least 24 hours before the end of the period in Settings → Apple Account → Subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por %@. La suscripción se renueva automáticamente hasta que la canceles. Cancela al menos 24 horas antes del final del periodo en Ajustes → Cuenta de Apple → Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par %@. L’abonnement se renouvelle automatiquement jusqu’à son annulation. Annulez au moins 24 heures avant la fin de la période dans Réglages → Compte Apple → Abonnements."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ за %@. Подписка продлевается автоматически, пока вы её не отмените. Отмените не позднее чем за 24 часа до конца периода: Настройки → Apple Account → Подписки."
          }
        }
      }
    },
    "paywall.finePrint.trial" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gratis, danach %2$@ pro %3$@. Das Abo verlängert sich automatisch, bis du es kündigst. Damit nichts berechnet wird, kündige spätestens 24 Stunden vor Ende des Testzeitraums unter Einstellungen → Apple Account → Abonnements."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ free, then %2$@ per %3$@. The subscription renews automatically until you cancel it. To avoid being charged, cancel at least 24 hours before the trial ends in Settings → Apple Account → Subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gratis, luego %2$@ por %3$@. La suscripción se renueva automáticamente hasta que la canceles. Para que no se te cobre, cancela al menos 24 horas antes de que termine la prueba en Ajustes → Cuenta de Apple → Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essai gratuit de %1$@, puis %2$@ par %3$@. L’abonnement se renouvelle automatiquement jusqu’à son annulation. Pour ne pas être facturé, annulez au moins 24 heures avant la fin de l’essai dans Réglages → Compte Apple → Abonnements."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ бесплатно, затем %2$@ за %3$@. Подписка продлевается автоматически, пока вы её не отмените. Чтобы не было списания, отмените не позднее чем за 24 часа до конца пробного периода: Настройки → Apple Account → Подписки."
          }
        }
      }
    },
