    "import.limits.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu %lld Fotos pro Import. JPEG, HEIC oder PNG, bis 100 MB und 60 Megapixel pro Datei. Eine Kopie wird in der App gespeichert; die Originale in „Fotos“ bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to %lld photos per import. JPEG, HEIC or PNG, up to 100 MB and 60 megapixels per file. A copy is stored in the app; the originals in Photos stay unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta %lld fotos por importación. JPEG, HEIC o PNG, hasta 100 MB y 60 megapíxeles por archivo. Se guarda una copia en la app; los originales en Fotos no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à %lld photos par import. JPEG, HEIC ou PNG, jusqu’à 100 Mo et 60 mégapixels par fichier. Une copie est stockée dans l’app ; les originaux dans Photos restent inchangés."
          }
