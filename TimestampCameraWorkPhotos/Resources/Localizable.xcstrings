    "location.approximate.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Genauer Standort“ ist für diese App aus. Fotos erhalten eine ungefähre Position, eine genaue Adresse wird nicht angegeben. Du kannst „Genauer Standort“ in den Einstellungen aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precise Location is off for this app. Photos get an approximate position, and no exact address is claimed. You can turn on Precise Location in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación exacta está desactivada para esta app. Las fotos reciben una posición aproximada y no se indica una dirección exacta. Puedes activar la ubicación exacta en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position exacte est désactivée pour cette app. Les photos reçoivent une position approximative et aucune adresse exacte n’est indiquée. Vous pouvez activer la position exacte dans Réglages."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точная геопозиция для приложения выключена. Фото получают приблизительное место, точный адрес не заявляется. Точную геопозицию можно включить в Настройках."
          }
        }
      }
    },
