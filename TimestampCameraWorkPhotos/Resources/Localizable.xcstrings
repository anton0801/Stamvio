        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stempel ist für dieses Foto zu groß. Kürze oder blende Felder aus – ein abgeschnittener Stempel wird nie exportiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
