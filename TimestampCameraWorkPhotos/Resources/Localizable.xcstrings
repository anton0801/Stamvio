          }
        }
      }
    },
    "export.withoutLocation.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Standort: GPS wird aus den Metadaten entfernt, Adresse und Koordinaten fehlen im Stempel. Das private Original in der App bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without location: GPS is removed from the file metadata, and the address and coordinates are left off the stamp. The private original in the app is not changed."
          }
