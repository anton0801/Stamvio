    "project.create.proHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kostenlose Plan umfasst insgesamt ein Projekt, auch wenn es gelöscht oder archiviert wurde. Beim Tippen auf „Erstellen“ kannst du Pro ansehen. Deine Eingaben bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free includes one project in total, even if it was deleted or archived. When you tap Create, you can see Pro. Your entries are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan gratuito incluye un solo proyecto en total, aunque se haya eliminado o archivado. Al tocar Crear podrás ver Pro. Lo que escribiste se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’offre gratuite inclut un seul projet au total, même supprimé ou archivé. En touchant Créer, vous pourrez voir Pro. Vos saisies sont conservées."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатная версия включает один проект за всё время, даже если он удалён или в архиве. После нажатия «Создать» можно посмотреть Pro. Введённые данные сохранятся."
          }
        }
      }
    },
