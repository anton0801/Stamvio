    "privacy.clearCache.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Vorschaubilder und temporäre Dateien. Originale, Bildtexte und gespeicherte Berichte bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes thumbnails and temporary files. Originals, captions and saved reports are not touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina miniaturas y archivos temporales. No afecta a originales, pies de foto ni informes guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les miniatures et les fichiers temporaires. Les originaux, légendes et rapports enregistrés ne sont pas touchés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет миниатюры и временные файлы. Оригиналы, подписи и сохранённые отчёты не затрагиваются."
          }
        }
      }
    },
