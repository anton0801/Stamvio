    "backup.freeNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im kostenlosen Plan können wiederhergestellte Projekte angesehen und exportiert werden; bearbeitet werden kann jeweils ein Projekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Free plan, restored projects can be viewed and exported; one project at a time can be edited."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el plan gratuito, los proyectos restaurados se pueden ver y exportar; se puede editar un proyecto a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec l’offre gratuite, les projets restaurés peuvent être consultés et exportés ; un seul projet à la fois peut être modifié."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В бесплатной версии восстановленные проекты можно просматривать и выгружать; редактировать можно один проект."
          }
        }
      }
    },
    "backup.purchasesNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sicherung enthält oder überträgt nie ein Abo. Für Pro „Käufe wiederherstellen“ verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup never contains or transfers a subscription. Use Restore Purchases for Pro."
          }
        },
        "es" : {
