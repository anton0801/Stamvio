    "unsorted.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnelle Fotos ohne Projekt. Verschiebe sie in ein Projekt, um sie in Berichten zu verwenden. Im kostenlosen Plan zählen sie zu den Gratis-Fotos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick shots without a project. Move them into a project to use them in reports. On the Free plan they count toward the free photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos rápidas sin proyecto. Muévelas a un proyecto para usarlas en informes. En el plan gratuito cuentan dentro de las fotos gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos rapides sans projet. Déplacez-les dans un projet pour les utiliser dans des rapports. Avec l’offre gratuite, elles comptent dans les photos gratuites."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрые снимки без проекта. Перенесите их в проект, чтобы использовать в отчётах. В бесплатной версии они входят в лимит бесплатных фото."
          }
        }
      }
    }
