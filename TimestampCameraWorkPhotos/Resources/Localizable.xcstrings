    "report.legend.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeiten und Orte stammen von der Geräteuhr, aus Datei-Metadaten oder Nutzereingaben; sie sind nicht unabhängig zertifiziert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times and places come from the device clock, file metadata or user input; they are not independently certified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas y los lugares proceden del reloj del dispositivo, de los metadatos o de lo introducido por el usuario; no están certificados de forma independiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures et les lieux proviennent de l’horloge de l’appareil, des métadonnées des fichiers ou de la saisie de l’utilisateur ; ils ne sont pas certifiés de façon indépendante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время и места берутся из часов устройства, метаданных файлов или ввода пользователя и не заверены независимо."
          }
        }
      }
    },
    "report.legend.location" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte: GPS – vom Telefon bei der Aufnahme gemessen (± Genauigkeit). Ungefähr – reduzierte Genauigkeit, keine genaue Adresse. Manueller Ort und Projektadresse – vom Nutzer eingegeben, nicht gemessen. Aus den Datei-Metadaten – aus der importierten Datei gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locations: GPS — measured by the phone at capture (± accuracy). Approximate — reduced accuracy, no exact address is claimed. Manual location and Project address — entered by the user, not measured. From file metadata — read from the imported file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubicaciones: GPS — medida por el teléfono al hacer la foto (± precisión). Aproximada — precisión reducida, no se indica una dirección exacta. Ubicación manual y Dirección del proyecto — introducidas por el usuario, no medidas. De los metadatos del archivo — leída del archivo importado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieux : GPS — mesuré par le téléphone à la prise de vue (± précision). Approximative — précision réduite, aucune adresse exacte n’est indiquée. Lieu manuel et Adresse du projet — saisis par l’utilisateur, non mesurés. Issue des métadonnées du fichier — lue dans le fichier importé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места: GPS — измерено телефоном при съёмке (± погрешность). Приблизительно — пониженная точность, точный адрес не заявляется. Место вручную и Адрес проекта — введены пользователем, не измерены. Из метаданных файла — прочитано из импортированного файла."
          }
        }
      }
    },
    "report.legend.time" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitquellen: Gerätezeit – Uhr des Telefons bei der Aufnahme in der App. Importierte Metadaten – in der Fotodatei gespeichertes Datum. Datum manuell – vom Nutzer eingegeben. Der UTC-Versatz wird angezeigt, wenn er bekannt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time sources: Device time — the phone's clock when the photo was taken in the app. Imported metadata — date stored in the photo file. Manual date — entered by the user. The UTC offset is shown when it is known."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origen de la hora: Hora del dispositivo — reloj del teléfono al hacer la foto en la app. Metadatos importados — fecha guardada en el archivo. Fecha manual — introducida por el usuario. El desfase UTC se muestra cuando se conoce."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources de l’heure : Heure de l’appareil — horloge du téléphone lors de la prise de vue dans l’app. Métadonnées importées — date enregistrée dans le fichier photo. Date manuelle — saisie par l’utilisateur. Le décalage UTC est indiqué lorsqu’il est connu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник времени: Время устройства — часы телефона в момент съёмки в приложении. Импортированные метаданные — дата, записанная в файле фото. Дата вручную — введена пользователем. Смещение UTC указывается, когда известно."
          }
        }
      }
    },
