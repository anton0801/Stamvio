    "backup.restore.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wird zuerst geprüft (Version, Dateien, Prüfsummen, Größe). Projekte werden neu hinzugefügt; vorhandene werden nie überschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is checked first (version, files, checksums, size). Projects are added as new; existing projects are never overwritten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se comprueba el archivo (versión, archivos, sumas de control, tamaño). Los proyectos se añaden como nuevos; los existentes nunca se sobrescriben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est d’abord vérifié (version, fichiers, sommes de contrôle, taille). Les projets sont ajoutés comme nouveaux ; les projets existants ne sont jamais écrasés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала файл проверяется (версия, состав, контрольные суммы, размер). Проекты добавляются как новые; существующие никогда не перезаписываются."
          }
        }
      }
    },
