            "value" : "Informes grandes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapports volumineux"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большие отчёты"
          }
        }
      }
    },
    "help.location.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standort ist standardmäßig aus. Wenn du ihn aktivierst, fragt die App nur bei Nutzung nach Zugriff und misst nur bei geöffneter Kamera. Eine Position wird nur angehängt, wenn sie höchstens 30 Sekunden vor dem Auslösen gemessen wurde; sonst wird das Foto ohne Koordinaten gespeichert. Bei ungefährem Standort zeigt die App die Genauigkeit und gibt keine genaue Hausadresse an. Adressen ermittelt Apple Karten aus den Koordinaten; Fotos werden nie gesendet. Du kannst jederzeit einen manuellen Ort eingeben, der als manuell markiert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is off by default. When you turn it on, the app asks for access only while in use and measures your position only while the camera is open. A position is attached to a photo only if it was measured within 30 seconds of the shutter; otherwise the photo is saved without coordinates. With approximate location, the app shows the accuracy and does not claim an exact street address. Addresses are looked up by Apple Maps from the coordinates; photos are never sent. You can always type a manual location, which is marked as manual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación está desactivada por defecto. Al activarla, la app pide acceso solo mientras se usa y mide la posición solo con la cámara abierta. Una posición se añade a una foto solo si se midió como máximo 30 segundos antes del disparo; si no, la foto se guarda sin coordenadas. Con ubicación aproximada, la app muestra la precisión y no presenta una dirección exacta. Las direcciones las busca Apple Maps a partir de las coordenadas; las fotos nunca se envían. Siempre puedes escribir una ubicación manual, que se marca como manual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position est désactivée par défaut. Une fois activée, l’app demande l’accès uniquement pendant l’utilisation et ne mesure la position que lorsque l’appareil photo est ouvert. Une position n’est associée à une photo que si elle a été mesurée au plus 30 secondes avant le déclenchement ; sinon la photo est enregistrée sans coordonnées. Avec une position approximative, l’app affiche la précision et n’indique pas d’adresse exacte. Les adresses sont trouvées par Apple Plans à partir des coordonnées ; les photos ne sont jamais envoyées. Vous pouvez toujours saisir un lieu manuel, marqué comme manuel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Местоположение по умолчанию выключено. После включения приложение запрашивает доступ только при использовании и определяет позицию только при открытой камере. Позиция прикрепляется к снимку, только если измерена не раньше чем за 30 секунд до спуска; иначе фото сохраняется без координат. При приблизительной геолокации показывается погрешность, точный адрес дома не заявляется. Адрес по координатам определяет Apple Maps; фото никогда не отправляются. Всегда можно ввести место вручную — оно будет помечено как ручное."
          }
        }
      }
    },
    "help.location.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort und Adressen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location and addresses"
          }
        },
        "es" : {
