    "help.largePDF.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bericht kann bis zu 200 Fotos enthalten (kostenlos: bis zu 20). Fotos werden verkleinert, damit Dateien handlich bleiben; die Qualität „Kompakt“ macht sie kleiner. Die echte Dateigröße wird nach dem Erstellen angezeigt. Bei zu wenig Speicher „Kompakt“ oder weniger Fotos wählen. Lass die App während der Erstellung geöffnet – stoppt iOS sie im Hintergrund, einfach erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A report can include up to 200 photos (Free: up to 20). Photos are scaled down to keep files manageable; the Compact quality makes files smaller. The real file size is shown after creation. If there isn't enough space, choose Compact or fewer photos. Keep the app open while the report is created — if iOS stops it in the background, just try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe puede incluir hasta 200 fotos (gratis: hasta 20). Las fotos se reducen para que los archivos sean manejables; la calidad Compacta los hace más pequeños. El tamaño real se muestra tras crearlo. Si no hay espacio suficiente, elige Compacta o menos fotos. Mantén la app abierta mientras se crea el informe; si iOS lo detiene en segundo plano, vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport peut contenir jusqu’à 200 photos (gratuit : jusqu’à 20). Les photos sont réduites pour garder des fichiers maniables ; la qualité Compacte les allège. La taille réelle s’affiche après la création. Si l’espace manque, choisissez Compacte ou moins de photos. Gardez l’app ouverte pendant la création : si iOS l’arrête en arrière-plan, réessayez simplement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В отчёт можно включить до 200 фото (бесплатно — до 20). Фото уменьшаются, чтобы файл оставался удобным; качество «Компактное» делает файл меньше. Реальный размер показывается после создания. Если места мало, выберите «Компактное» или меньше фото. Не закрывайте приложение во время создания — если iOS остановит его в фоне, просто повторите."
          }
        }
      }
    },
    "help.largePDF.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große Berichte"
          }
        },
        "en" : {
